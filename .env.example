# Segredos (*_CLIENT_SECRET, SHOPEE_PARTNER_KEY, *_REFRESH_TOKEN, ANTHROPIC_API_KEY)
# podem ficar vazios aqui: o painel grava no cofre cifrado, não neste arquivo.
# Um valor preenchido aqui ainda funciona; "python cli.py cofre migrar" copia
# para o cofre e lista as linhas que você pode apagar à mão.

# ---------- Mercado Livre ----------
# Crie a aplicação em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_SELLER_ID=
ML_SITE_ID=MLB

# ---------- Amazon SP-API ----------
# Exige conta Seller Central aprovada + app no Developer Central
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_MARKETPLACE_ID=A2Q3Y263D00KWC
AMZ_ENDPOINT=https://sellingpartnerapi-na.amazon.com

# ---------- Redação das respostas ----------
ANTHROPIC_API_KEY=
# Modelo da Claude API. Padrão: claude-opus-5-5 (US$ 4 / US$ 20 por milhão de
# tokens de entrada / saída). claude-sonnet-5-5 custa metade (US$ 2 / US$ 10).
# A escolha é sua; o programa não troca sozinho. Exceção: se o modelo recusar
# por política, a API pode responder (e cobrar) pelo modelo de reserva que a
# Anthropic recomenda; um evento diz qual foi.
MODELO_CLAUDE=claude-opus-5-5
# Esforço do modelo: low (padrão), medium, high, xhigh, max. Mais esforço,
# mais custo e mais demora. Também define max_tokens e o tempo de espera:
# low 4000 / 60 s, medium 8000 / 120 s, high, xhigh e max 16000 / 300 s.
ESFORCO_CLAUDE=low

# ---------- Regras de negócio ----------
MARGEM_MINIMA_PCT=18
# Só muda o rótulo da fila ([ROTINA] / [ACIMA DO TETO]). Toda compra espera
# aprovação, abaixo ou acima do teto.
TETO_COMPRA_AUTOMATICA=300
ALIQUOTA_IMPOSTO_PCT=4
PRAZO_FORNECEDOR_DIAS=5
# Você emite nota fiscal em toda venda? true ou false. Vazio bloqueia as
# compras na conformidade até você responder.
EMITE_NOTA_FISCAL=

DB_PATH=agente.db
# true (padrão): aprovar não publica resposta, não muda preço e grava a ordem
# de compra marcada como teste. Só um "não" explícito desliga: false, 0, no,
# off ou nao. Vazio ou digitado errado mantém ligado. Aprovar em simulação não
# consome o item: o pedido e a pergunta voltam para a fila quando você
# desligar. Desligado, a ordem de compra continua sendo só um arquivo: o envio
# ao fornecedor é com você.
MODO_SIMULACAO=true

# ---------- Shopee Open Platform ----------
# open.shopee.com -> App Management. Token vale só 4 horas.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SANDBOX=true

# ---------- LGPD ----------
# Faça backup desta chave. Sem ela, os dados de comprador ficam ilegíveis.
CHAVE_LGPD=
RETENCAO_PII_DIAS=1825

# ---------- Cofre de credenciais ----------
# CHAVE_COFRE NÃO é lida deste arquivo: defina no ambiente do sistema, ou deixe
# o programa criar .chave_cofre na pasta de dados. Faça backup dela.

# ---------- Painel ----------
# Porta de 1 a 65535; intervalo do worker em segundos, no mínimo 30. Valor
# inválido (ou com comentário na mesma linha) usa o padrão, com aviso.
PORTA_PAINEL=8777
HOST_PAINEL=127.0.0.1
INTERVALO_WORKER=300
WORKER_ATIVO=true
ABRIR_NAVEGADOR=true
