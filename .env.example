# ---------- Mercado Livre ----------
# Crie a aplicação em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_SELLER_ID=
ML_SITE_ID=MLB

# ---------- Amazon SP-API ----------
# Exige conta Seller Central aprovada + app no Developer Central
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_MARKETPLACE_ID=A2Q3Y263D00KWC
AMZ_ENDPOINT=https://sellingpartnerapi-na.amazon.com

# ---------- Redação das respostas ----------
ANTHROPIC_API_KEY=

# ---------- Regras de negócio ----------
MARGEM_MINIMA_PCT=18
TETO_COMPRA_AUTOMATICA=300
ALIQUOTA_IMPOSTO_PCT=4
PRAZO_FORNECEDOR_DIAS=5

DB_PATH=agente.db
MODO_SIMULACAO=true

# ---------- Shopee Open Platform ----------
# open.shopee.com -> App Management. Token vale só 4 horas.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SANDBOX=true

# ---------- LGPD ----------
# Faça backup desta chave. Sem ela, os dados de comprador ficam ilegíveis.
CHAVE_LGPD=
RETENCAO_PII_DIAS=1825

# ---------- Painel ----------
PORTA_PAINEL=8777
HOST_PAINEL=127.0.0.1
INTERVALO_WORKER=300
WORKER_ATIVO=true
ABRIR_NAVEGADOR=true
