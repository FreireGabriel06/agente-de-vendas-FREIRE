# Copy to instancias/<client>.env (ignored by git) and fill in. One file per
# client instance; each instance has its own database and keys in its volume.

# Name clients type to open this panel (must match the Caddyfile block).
HOSTS_PAINEL=cliente1.example.com

# Exposed panel: authenticator code required for every operator.
MFA_OBRIGATORIO=true

# Simulation on until the client confirms the flow. Reading Amazon data does
# not depend on it.
MODO_SIMULACAO=true

# ---------- Amazon SP-API (read-only) ----------
# Marketplace and endpoint of the client's region:
#   US  ATVPDKIKX0DER   https://sellingpartnerapi-na.amazon.com   https://sellercentral.amazon.com
#   CA  A2EUQ1WTGCTBG2  https://sellingpartnerapi-na.amazon.com   https://sellercentral.amazon.ca
#   MX  A1AM78C64UM0Y8  https://sellingpartnerapi-na.amazon.com   https://sellercentral.amazon.com.mx
#   BR  A2Q3Y263D00KWC  https://sellingpartnerapi-na.amazon.com   https://sellercentral.amazon.com.br
#   UK  A1F83G8C2ARO7P  https://sellingpartnerapi-eu.amazon.com   https://sellercentral-europe.amazon.com
#   DE  A1PA6795UKMFR9  https://sellingpartnerapi-eu.amazon.com   https://sellercentral-europe.amazon.com
#   FR  A13V1IB3VIYZZH  https://sellingpartnerapi-eu.amazon.com   https://sellercentral-europe.amazon.com
#   IT  APJ6JRA9NG5V4   https://sellingpartnerapi-eu.amazon.com   https://sellercentral-europe.amazon.com
#   ES  A1RKKUPIHCS9HS  https://sellingpartnerapi-eu.amazon.com   https://sellercentral-europe.amazon.com
AMZ_MARKETPLACE_ID=ATVPDKIKX0DER
AMZ_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMZ_SELLER_CENTRAL=https://sellercentral.amazon.com
# App ID from the Solution Provider Portal and this instance's redirect URI
# (register it in the app's OAuth Redirect URIs).
AMZ_APPLICATION_ID=
AMZ_REDIRECT_URI=https://cliente1.example.com/oauth/amazon/retorno
# The LWA client ID and secret are saved through the panel (encrypted vault).

# ---------- Mercado Livre (Latin America) ----------
# MLB Brazil, MLA Argentina, MLM Mexico, MLC Chile, MCO Colombia, MLU Uruguay, MPE Peru
ML_SITE_ID=MLB
# Register this address in the Mercado Livre app (DevCenter) as its redirect URI.
ML_REDIRECT_URI=https://cliente1.example.com/oauth/ml/retorno
